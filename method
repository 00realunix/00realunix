            <div style="margin-bottom:10px;">
                <label style="display:block; margin-bottom:5px; font-weight:bold;">Card Number *</label>
                <input type="text" id="custompayment_method_cc_number" name="payment[cc_number]" class="input-text required-entry validate-cc-number" style="width:100%; max-width:300px;" />
