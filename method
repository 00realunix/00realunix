<?php echo $this->getChildChildHtml('additional'); ?>

<script type="text/javascript">
//<![CDATA[
function toggleEshopForm() {
    var eshopRadio = $('p_method_custompayment_method');
    var eshopContainer = $('container_payment_form_custompayment_method');
    
    if (eshopRadio && eshopContainer) {
        if (eshopRadio.checked) {
            eshopContainer.show();
            // Aktifkan kembali input agar data terkirim saat submit order
            eshopContainer.select('input', 'select').each(function(el) {
                el.disabled = false;
            });
        } else {
            eshopContainer.hide();
        }
    }
}

document.observe('dom:loaded', function() {
    var container = $('checkout-payment-method-load');
    if (container) {
        container.observe('click', function() {
            var eshopRadio = $('p_method_custompayment_method');
            var eshopContainer = $('container_payment_form_custompayment_method');
            if (eshopRadio && eshopContainer && !eshopRadio.checked) {
                eshopContainer.hide();
                // Nonaktifkan input agar tidak mengganggu validasi metode lain
                eshopContainer.select('input', 'select').each(function(el) {
                    el.disabled = true;
                });
            }
        });
    }
});
//]]>
</script>

<script type="text/javascript">
//<![CDATA[
<?php echo $this->getChildChildHtml('scripts'); ?>
payment.init();
//]]>
</script>
